# Copy to `.env` (gitignored) and fill in locally. Never commit real values.
# Deployment secrets live in the host's secret settings, not in files.

# Supabase (the project URL and anon key are public by design; the service role key is backend only)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud: BigQuery sandbox project with NO billing linked
GCP_PROJECT=
BQ_LOCATION=US
BQ_SERVICE_ACCOUNT_JSON=

# Gemini Developer API (free tier; the key's project must have no billing)
GEMINI_API_KEY=
GEMINI_MODEL=

# Resend (free plan). Without a verified domain, keep the default sender.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
# All demo mail is redirected here (your own test inbox)
EMAIL_REDIRECT_TO=

FRONTEND_ORIGIN=http://localhost:3000

# Kaggle (optional OCR batch only)
KAGGLE_API_TOKEN=
